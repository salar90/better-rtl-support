<?xml version="1.0"?>
<ruleset name="Better RTL Support">
	<file>./src</file>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.2-"/>
	<config name="minimum_wp_version" value="5.3"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress-Extra">
		<!-- Legacy file/class naming kept for backwards compatibility. -->
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="WordPress.NamingConventions.ValidVariableName"/>
	</rule>
	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="better-rtl-support"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="brtls"/>
				<element value="better_rtl"/>
			</property>
		</properties>
		<!-- Views are included from inside a method, so their variables are not globals. -->
		<exclude-pattern>src/views/*</exclude-pattern>
	</rule>
</ruleset>
